```gitignore
# Dependencies
node_modules/

# Logs and temp files
*.log
*.tmp
*.swp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Build artifacts
dist/
build/
*.pyc
__pycache__/
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out
*.class

# System files
.DS_Store
Thumbs.db
coverage/
htmlcov/
.coverage
.mypy_cache/
.pytest_cache/
target/
.gradle/
```